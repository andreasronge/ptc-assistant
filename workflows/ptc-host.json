{
  "$schema": "https://ptc-runner.dev/schemas/ptc-host-config.schema.json",
  "credentials": {
    "google_client_file": {
      "env": "GOOGLE_MCP_CLIENT_FILE"
    },
    "google_token_file": {
      "env": "GOOGLE_MCP_TOKEN_FILE"
    },
    "decisions_key": {
      "env": "OPENROUTER_API_KEY"
    }
  },
  "install": {
    "google": {
      "source": "mcp",
      "data_class": "private_inspection",
      "accepts_data": [
        "private_inspection"
      ],
      "installation_revision": "google-mcp-0.1.0",
      "transport": {
        "type": "stdio",
        "command": "node",
        "cwd": "../google-mcp",
        "args": [
          "dist/cli.js"
        ],
        "inherit_environment": true,
        "env": {
          "GOOGLE_MCP_CLIENT_FILE": {
            "binding": "google_client_file"
          },
          "GOOGLE_MCP_TOKEN_FILE": {
            "binding": "google_token_file"
          }
        },
        "start_timeout_ms": 15000
      },
      "tools": {
        "search_messages": {
          "as": "google.search",
          "effect": "read",
          "error_feedback": "bounded"
        },
        "list_events": {
          "as": "google.events",
          "effect": "read",
          "error_feedback": "bounded"
        },
        "get_threads": {
          "as": "google.threads",
          "effect": "read",
          "error_feedback": "bounded"
        },
        "list_sent_recipients": {
          "as": "google.sent",
          "effect": "read",
          "error_feedback": "bounded"
        }
      },
      "ceilings": {
        "timeout_ms": 45000,
        "max_catalog_tools": 8,
        "max_result_bytes": 262144
      }
    },
    "decisions": {
      "source": "decision",
      "model": "typesafe/jev-1.13",
      "credential": "decisions_key",
      "routing": {
        "zdr": true,
        "data_collection": "deny",
        "allow_fallbacks": false
      },
      "usage_guarantees": {
        "tokens": true,
        "cost_currency": "USD"
      },
      "max_cost_per_call": {
        "currency": "USD",
        "amount": "0.01"
      },
      "max_total_tokens_per_call": 8000,
      "accepts_data": [
        "normal",
        "private_inspection"
      ],
      "installation_revision": "jev-1.13-decisions-v1"
    }
  },
  "limits": {
    "evaluation_heap_words": 10000000
  }
}
