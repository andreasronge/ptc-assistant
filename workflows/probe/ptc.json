{
  "$schema": "https://ptc-runner.dev/schemas/ptc-application-manifest.schema.json",
  "version": 1,
  "workflow": {
    "components": [
      {"id": "probe.workflow", "path": "workflow.clj", "dependencies": ["kernel"]},
      {"library": "kernel"}
    ],
    "entry": "probe.workflow/run"
  },
  "missions": {
    "google": {
      "components": [{"id": "probe.google", "path": "google.clj"}],
      "providers": ["google"]
    }
  },
  "providers": {
    "mission": [{"name": "google", "config": {"allow": ["google.search", "google.events"]}}]
  },
  "input": {
    "value": {
      "query": "in:inbox",
      "limit": 50,
      "time_min": "2026-09-25T00:00:00+02:00",
      "time_max": "2026-09-26T00:00:00+02:00"
    }
  },
  "limits": {
    "run_duration_ms": 120000,
    "workflow_timeout_ms": 120000,
    "evaluation_timeout_ms": 60000
  },
  "labels": {"name": "ptc-assistant-probe"}
}
