;; Schema example for the private rules file ($PTC_ASSISTANT_DATA/rules/mail.edn).
;; Senders use reserved example domains only; the real file never enters
;; this repository.
{:version 1
 :bulk {:headers ["List-Unsubscribe" "Precedence" "Auto-Submitted"]
        :sender-patterns ["^no-?reply@" "^newsletter@"]
        :gmail-categories ["CATEGORY_PROMOTIONS" "CATEGORY_SOCIAL" "CATEGORY_UPDATES"]}
 :person {:known-correspondents-window-days 365}
 :important {:gmail-label "IMPORTANT"}
 :receipt {:subject-patterns ["(?i)receipt|invoice|renewal|subscription|payment|kvitto|faktura"]
           :amount-pattern "(?i)(\\d+[.,]\\d{2})\\s*(kr|sek|eur|usd|€|\\$)"
           :vendors {"billing@streaming.example" "Example Streaming"
                     "invoices@cloud.example.com" "Example Cloud"}}
 :categories {"receipt" "Payment receipt or invoice"
              "renewal" "Upcoming subscription renewal"
              "personal" "Written by a person to the owner"
              "bulk" "Newsletter or marketing"}}
